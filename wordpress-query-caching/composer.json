{
	"name": "digitallotus/cached-event-listings",
	"description": "An events post type with a cached upcoming/past listing — object caching with generation-based invalidation.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Gabi Dombrowski"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^11 || ^12",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.2",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1"
	},
	"autoload": {
		"psr-4": {
			"DigitalLotus\\CachedEventListings\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"DigitalLotus\\CachedEventListings\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"check": [
			"@lint",
			"@test"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
