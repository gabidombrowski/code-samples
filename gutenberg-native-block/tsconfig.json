{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"types": [ "jest" ]
	},
	"include": [ "src" ]
}
